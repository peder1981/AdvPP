// Endpoints REST do adapter de armazéns (plano PO-UI onda 1, Task 7).
// A query string (page/pageSize/filter/order/fields) é lida da requisição
// corrente pelo próprio adapter — o oRest só devolve a resposta.

@Get("/api/est/v1/armazens")
User Function ArmazensList(oParam)
	Local oRepo := ArmazensRepo():New("GET", .T.)
	oRepo:SetQuery("SELECT #QueryFields# FROM NNR #QueryWhere#")
	If !oRepo:Execute()
		oRest:setStatusCode(400)
		oRest:setResponse({"message": oRepo:GetErrorMessage()})
		Return Nil
	EndIf
	oRest:setResponse(oRepo:GetJsonResponse())
Return Nil

@Get("/api/est/v1/armazensfix")
User Function ArmazensFix(oParam)
	// Mesma lista, mas com WHERE/ORDER explícitos do fonte — a URL só
	// controla paginação.
	Local oRepo := ArmazensRepo():New("GET", .T.)
	oRepo:SetQuery("SELECT #QueryFields# FROM NNR #QueryWhere#")
	oRepo:SetWhere("NNR_DESCRI <> ''")
	oRepo:SetOrder("-codigo")
	If !oRepo:Execute()
		oRest:setStatusCode(400)
		oRest:setResponse({"message": oRepo:GetErrorMessage()})
		Return Nil
	EndIf
	oRest:setResponse(oRepo:GetJsonResponse())
Return Nil

@Get("/api/est/v1/armazens/:codigo")
User Function ArmazemGet(oParam)
	// Um armazém pelo código (PoPageDynamicDetail/Edit com SetId). O código
	// vai pelo filtro OData do adapter (parametrizado; aspas duplicadas).
	Local cCod := oRest:getPathParamsRequest()["codigo"]
	Local oRepo := ArmazensRepo():New("GET", .T.)
	Local jResp
	oRepo:SetQuery("SELECT #QueryFields# FROM NNR #QueryWhere#")
	oRepo:SetUrlFilter({{"FILTER", "codigo eq '" + StrTran(cCod, "'", "''") + "'"}})
	If !oRepo:Execute()
		oRest:setStatusCode(400)
		oRest:setResponse({"message": oRepo:GetErrorMessage()})
		Return Nil
	EndIf
	jResp := oRepo:GetJsonResponse()
	If Len(jResp["items"]) == 0
		oRest:setStatusCode(404)
		oRest:setResponse({"message": "armazém " + cCod + " não encontrado"})
		Return Nil
	EndIf
	oRest:setResponse(jResp["items"][1])
Return Nil
