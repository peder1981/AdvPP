// Repo de armazéns: Class FROM FWAdapterBaseV2 imitando a forma do corpus
// (plano PO-UI onda 1, Task 7). Monta o mapa de campos com TamSx3 e expõe
// os métodos do adapter via _Super/bytecode.

Class ArmazensRepo from FWAdapterBaseV2
EndClass

Method New(cVerbo, lList) Class ArmazensRepo Constructor
	_Super:New(cVerbo, lList)
	// aStruct: {campo, tipo, tamanho, decimais} por coluna; TamSx3 devolve
	// {nTamanho, nDecimais, cTipo}, como no Protheus (SX3 da fixture).
	Local aTamCod  := TamSx3("NNR_CODIGO")
	Local aTamDes  := TamSx3("NNR_DESCRI")
	Local aTamEst  := TamSx3("NNR_ESTOQUE")
	Local aTamFil  := TamSx3("NNR_FILIAL")
	Local aStruct  := {}
	aStruct := {
		{"NNR_CODIGO", aTamCod[3], aTamCod[1], aTamCod[2]},
		{"NNR_DESCRI", aTamDes[3], aTamDes[1], aTamDes[2]},
		{"NNR_ESTOQUE", aTamEst[3], aTamEst[1], aTamEst[2]},
		{"NNR_FILIAL", aTamFil[3], aTamFil[1], aTamFil[2]}
	}
	::AddMapFields("codigo",  "NNR_CODIGO",  .T., .T., aStruct)
	::AddMapFields("descri",  "NNR_DESCRI",  .T., .T., aStruct)
	::AddMapFields("estoque", "NNR_ESTOQUE", .T., .F., aStruct)
	::AddMapFields("filial",  "NNR_FILIAL",  .T., .T., aStruct)
Return Self
